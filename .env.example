# Ranger secrets. Copy to .env and fill in. .env is git-ignored.
# Nothing in this file belongs in ranger.toml, and nothing in ranger.toml belongs here.

# --- Tier 1 (required now) ---
# Anthropic API key for the model provider.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Tier 1 (optional) ---
# Override the config file location. Defaults to ./ranger.toml
# RANGER_CONFIG=/absolute/path/to/ranger.toml

# Override the vault root without editing ranger.toml. Useful if the vault
# moves to the external drive and you do not want that path in git.
# RANGER_VAULT_ROOT=/Volumes/Archive/Obsidian/MyVault

# --- Tier 3b (required for transcription) ---
# https://console.deepgram.com
DEEPGRAM_API_KEY=

# --- Tier 3c (required for speech) ---
# https://elevenlabs.io -> Settings -> API Keys
# Scope it to Text to Speech plus Voices read only; Ranger needs nothing else.
ELEVENLABS_API_KEY=
